// ============================================================
// OSE Thief Skills — skill progression tables, backstab
//
// All 8 thief skill tables (14 levels each). Backstab attack
// bonus and damage multiplier. Skill check mechanics.
//
// Hear Noise uses d6 (X-in-6); all other skills use d%
// (success if roll <= target%).
//
// Reference: oag/src/rules/thief.rs, OSE Rules Tome
// ============================================================

use "OSE"

system "OSE Thief" {


    // ========================================================
    //  IS-D6 FLAG
    //
    //  Returns true if the skill uses a d6 roll (Hear Noise),
    //  false if it uses d% (all other skills).
    // ========================================================

    derive is_d6(skill: ThiefSkill) -> bool {
        match skill {
            hear_noise => true,
            _          => false
        }
    }


    // ========================================================
    //  SKILL CHANCE TABLE
    //
    //  Skill chance at a given level (1-14).
    //  d% skills: percentage chance (1-99).
    //  Hear Noise: X-in-6 target (2-5).
    //
    //  Per OSE Rules Tome thief skill progression tables.
    // ========================================================

    table skill_chance(skill: ThiefSkill, level: int) -> int {

        // --- Climb Walls (d%) ---
        [climb_walls,  1] => 87,
        [climb_walls,  2] => 88,
        [climb_walls,  3] => 89,
        [climb_walls,  4] => 90,
        [climb_walls,  5] => 91,
        [climb_walls,  6] => 92,
        [climb_walls,  7] => 93,
        [climb_walls,  8] => 94,
        [climb_walls,  9] => 95,
        [climb_walls, 10] => 96,
        [climb_walls, 11] => 97,
        [climb_walls, 12] => 98,
        [climb_walls, 13] => 99,
        [climb_walls, 14] => 99,

        // --- Find Traps (d%) ---
        [find_traps,  1] => 10,
        [find_traps,  2] => 15,
        [find_traps,  3] => 20,
        [find_traps,  4] => 25,
        [find_traps,  5] => 30,
        [find_traps,  6] => 35,
        [find_traps,  7] => 40,
        [find_traps,  8] => 45,
        [find_traps,  9] => 50,
        [find_traps, 10] => 55,
        [find_traps, 11] => 60,
        [find_traps, 12] => 65,
        [find_traps, 13] => 70,
        [find_traps, 14] => 75,

        // --- Hear Noise (d6: X-in-6) ---
        [hear_noise,  1] => 2,
        [hear_noise,  2] => 2,
        [hear_noise,  3] => 3,
        [hear_noise,  4] => 3,
        [hear_noise,  5] => 3,
        [hear_noise,  6] => 3,
        [hear_noise,  7] => 4,
        [hear_noise,  8] => 4,
        [hear_noise,  9] => 4,
        [hear_noise, 10] => 4,
        [hear_noise, 11] => 5,
        [hear_noise, 12] => 5,
        [hear_noise, 13] => 5,
        [hear_noise, 14] => 5,

        // --- Hide in Shadows (d%) ---
        [hide_shadows,  1] => 10,
        [hide_shadows,  2] => 15,
        [hide_shadows,  3] => 20,
        [hide_shadows,  4] => 25,
        [hide_shadows,  5] => 30,
        [hide_shadows,  6] => 35,
        [hide_shadows,  7] => 40,
        [hide_shadows,  8] => 45,
        [hide_shadows,  9] => 50,
        [hide_shadows, 10] => 55,
        [hide_shadows, 11] => 60,
        [hide_shadows, 12] => 65,
        [hide_shadows, 13] => 70,
        [hide_shadows, 14] => 75,

        // --- Move Silently (d%) ---
        [move_silently,  1] => 20,
        [move_silently,  2] => 25,
        [move_silently,  3] => 30,
        [move_silently,  4] => 35,
        [move_silently,  5] => 40,
        [move_silently,  6] => 45,
        [move_silently,  7] => 50,
        [move_silently,  8] => 55,
        [move_silently,  9] => 60,
        [move_silently, 10] => 65,
        [move_silently, 11] => 70,
        [move_silently, 12] => 75,
        [move_silently, 13] => 80,
        [move_silently, 14] => 85,

        // --- Open Locks (d%) ---
        [open_locks,  1] => 15,
        [open_locks,  2] => 20,
        [open_locks,  3] => 25,
        [open_locks,  4] => 30,
        [open_locks,  5] => 35,
        [open_locks,  6] => 40,
        [open_locks,  7] => 45,
        [open_locks,  8] => 50,
        [open_locks,  9] => 55,
        [open_locks, 10] => 60,
        [open_locks, 11] => 65,
        [open_locks, 12] => 70,
        [open_locks, 13] => 75,
        [open_locks, 14] => 80,

        // --- Pick Pockets (d%) ---
        [pick_pockets,  1] => 20,
        [pick_pockets,  2] => 25,
        [pick_pockets,  3] => 30,
        [pick_pockets,  4] => 35,
        [pick_pockets,  5] => 40,
        [pick_pockets,  6] => 45,
        [pick_pockets,  7] => 50,
        [pick_pockets,  8] => 55,
        [pick_pockets,  9] => 60,
        [pick_pockets, 10] => 65,
        [pick_pockets, 11] => 70,
        [pick_pockets, 12] => 75,
        [pick_pockets, 13] => 80,
        [pick_pockets, 14] => 85,

        // --- Read Languages (d%, unavailable levels 1-3) ---
        [read_languages,  1] => 0,
        [read_languages,  2] => 0,
        [read_languages,  3] => 0,
        [read_languages,  4] => 20,
        [read_languages,  5] => 25,
        [read_languages,  6] => 30,
        [read_languages,  7] => 35,
        [read_languages,  8] => 40,
        [read_languages,  9] => 45,
        [read_languages, 10] => 50,
        [read_languages, 11] => 55,
        [read_languages, 12] => 60,
        [read_languages, 13] => 65,
        [read_languages, 14] => 70
    }


    // ========================================================
    //  BACKSTAB
    //
    //  backstab_attack_bonus: flat +4 to hit (per OSE Rules Tome).
    //  backstab_multiplier: damage multiplier by thief level.
    //    Level  1-4: x2,  Level  5-8: x3,
    //    Level 9-12: x4,  Level 13+:  x5
    // ========================================================

    derive backstab_attack_bonus() -> int {
        4
    }

    derive backstab_multiplier(level: int) -> int {
        match {
            level <= 4  => 2,
            level <= 8  => 3,
            level <= 12 => 4,
            _           => 5
        }
    }


    // ========================================================
    //  SKILL CHECK MECHANICS
    //
    //  thief_skill_check: d% roll, success if roll <= target%.
    //    Called for all d% skills (not Hear Noise).
    //
    //  hear_noise: d6 roll, success if roll <= X-in-6 target.
    //    Hear Noise uses a dedicated mechanic due to d6 die.
    // ========================================================

    mechanic thief_skill_check(skill: ThiefSkill, level: int) -> bool {
        let target = skill_chance(skill, level)
        let result = roll(1d100)
        result.total <= target
    }

    mechanic hear_noise(level: int) -> bool {
        let target = match {
            level <= 2  => 2,
            level <= 6  => 3,
            level <= 10 => 4,
            _           => 5
        }
        let result = roll(1d6)
        result.total <= target
    }
}
