// ============================================================
// OSE Wilderness Travel — terrain, foraging, starvation
//
// DSL-side tables and constants for wilderness mechanics:
//   terrain movement cost multipliers (fraction: num/den)
//   getting lost chance by terrain (X-in-6)
//   foraging availability and chance by terrain (X-in-6)
//   overland travel formula (movement_rate / 5 miles/day)
//   hunting chance (1-in-6 always)
//   starvation penalty cap (-4) and damage threshold (day 3)
//
// Reference: oag/src/state/wilderness.rs,
//            oag/src/engine/wilderness_engine.rs
// OSE Rules Tome — Wilderness Travel, Overland Movement
//
// Phase 1: defines derives only. DSL gates are wired in oag-mmg45.
// ============================================================

use "OSE"

system "OSE Wilderness" {


    // ========================================================
    //  TERRAIN TYPES
    //
    //  Prefixed with t_ to avoid global variant collisions.
    //  The DSL registers all enum variants in a single namespace,
    //  so names must be unique across all enums in the system.
    // ========================================================

    enum Terrain {
        t_clear,
        t_forest,
        t_hills,
        t_mountains,
        t_desert,
        t_swamp,
        t_jungle,
        t_ocean,
        t_river,
        t_barren,
        t_city
    }


    // ========================================================
    //  MOVEMENT COST
    //
    //  Each terrain imposes a fractional movement cost (num/den).
    //  A cost of (1,1) = full speed; (3,2) = 1.5× slower, etc.
    //
    //  Effective miles/day = (movement_rate / 5) * den / num
    //  Hexes/day           = effective_miles / 6  (6-mile hexes)
    //
    //  Clear / City / Ocean:        1/1 (no penalty)
    //  Hills / Forest / River / Barren: 3/2 (×1.5 cost)
    //  Desert / Swamp / Jungle:     2/1 (×2 cost)
    //  Mountains:                   3/1 (×3 cost)
    //
    //  Per OSE Rules Tome overland movement tables.
    // ========================================================

    // Movement cost fraction numerator.
    derive terrain_movement_cost_num(terrain: Terrain) -> int {
        match terrain {
            t_clear      => 1,
            t_city       => 1,
            t_ocean      => 1,
            t_hills      => 3,
            t_forest     => 3,
            t_river      => 3,
            t_barren     => 3,
            t_desert     => 2,
            t_swamp      => 2,
            t_jungle     => 2,
            t_mountains  => 3
        }
    }

    // Movement cost fraction denominator.
    derive terrain_movement_cost_den(terrain: Terrain) -> int {
        match terrain {
            t_clear      => 1,
            t_city       => 1,
            t_ocean      => 1,
            t_hills      => 2,
            t_forest     => 2,
            t_river      => 2,
            t_barren     => 2,
            t_desert     => 1,
            t_swamp      => 1,
            t_jungle     => 1,
            t_mountains  => 1
        }
    }

    // Hexes per day at a given movement rate in the given terrain.
    // Formula: (movement_rate / 5 * cost_den / cost_num) / 6, min 1.
    derive hexes_per_day(movement_rate: int, terrain: Terrain) -> int {
        let cost_num = terrain_movement_cost_num(terrain)
        let cost_den = terrain_movement_cost_den(terrain)
        let base_miles = movement_rate / 5
        let effective_miles = base_miles * cost_den / cost_num
        let hexes = effective_miles / 6
        match {
            hexes < 1 => 1,
            _         => hexes
        }
    }


    // ========================================================
    //  GETTING LOST
    //
    //  Chance of getting lost per day of travel (X-in-6).
    //  Roll d6; party is lost if roll <= this value.
    //
    //  Clear / City / Barren / Hills / Mountains: 1-in-6
    //  Forest / River / Desert / Ocean / Swamp / Jungle: 2-in-6
    // ========================================================

    derive terrain_lost_chance(terrain: Terrain) -> int {
        match terrain {
            t_clear      => 1,
            t_city       => 1,
            t_barren     => 1,
            t_hills      => 1,
            t_mountains  => 1,
            t_forest     => 2,
            t_river      => 2,
            t_desert     => 2,
            t_ocean      => 2,
            t_swamp      => 2,
            t_jungle     => 2
        }
    }


    // ========================================================
    //  FORAGING
    //
    //  terrain_can_forage: whether the terrain allows foraging.
    //  terrain_forage_chance: success chance (X-in-6), 0 if forbidden.
    //
    //  Impossible in: Ocean, City, Barren.
    //  Forest / Jungle / River: 2-in-6
    //  Clear / Hills / Swamp / Desert / Mountains: 1-in-6
    // ========================================================

    derive terrain_can_forage(terrain: Terrain) -> bool {
        match terrain {
            t_ocean  => false,
            t_city   => false,
            t_barren => false,
            _        => true
        }
    }

    derive terrain_forage_chance(terrain: Terrain) -> int {
        match terrain {
            t_forest    => 2,
            t_jungle    => 2,
            t_river     => 2,
            t_clear     => 1,
            t_hills     => 1,
            t_swamp     => 1,
            t_desert    => 1,
            t_mountains => 1,
            _           => 0
        }
    }


    // ========================================================
    //  HUNTING
    //
    //  Base hunting success chance (X-in-6).
    //  Per OSE Rules Tome: always 1-in-6, all passable terrain.
    //  Hunting on the open ocean is disallowed by the engine.
    // ========================================================

    derive hunt_chance() -> int {
        1
    }


    // ========================================================
    //  STARVATION
    //
    //  starvation_penalty_cap    : max attack/save modifier (-4)
    //  starvation_damage_die     : sides of HP loss die (1d4 → 4)
    //  starvation_damage_threshold: days without food before HP loss (3)
    //  starvation_penalty        : modifier for N days without food
    //
    //  Per OSE Rules Tome:
    //    Day 1+ without food: -1 per day to attacks and saves (cap -4).
    //    After 3 days without food: 1d4 HP damage per day.
    // ========================================================

    derive starvation_penalty_cap() -> int {
        -4
    }

    // Die size for starvation HP damage (1d<N>). Returns N.
    derive starvation_damage_die() -> int {
        4
    }

    // Days without food before HP damage begins.
    derive starvation_damage_threshold() -> int {
        3
    }

    // Attack/save penalty for N days without food, capped at -4.
    derive starvation_penalty(days: int) -> int {
        match {
            days <= 0 => 0,
            days == 1 => -1,
            days == 2 => -2,
            days == 3 => -3,
            _         => -4
        }
    }
}
